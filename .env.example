# Local SQLite file -- only used when TURSO_DATABASE_URL below is unset
# (offline dev/tests). Ignored otherwise.
DATABASE_URL="file:./prisma/dev.db"

# Secret used by NextAuth to sign/encrypt JWT session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Initial admin password, hashed and written into the Settings row by `prisma db seed`.
# Only read once at seed time -- change the password afterwards via the Settings page.
ADMIN_INITIAL_PASSWORD="change-me"

# Turso/LibSQL -- the real database, used both in production (Vercel) and
# locally whenever set (src/lib/db.ts prefers these over DATABASE_URL).
# From the Turso dashboard / `turso db show <db> --url` and
# `turso db tokens create <db>`.
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="change-me"
